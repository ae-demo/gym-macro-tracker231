  ],
  "description": "The single-page app both Trainees and Coaches use: sign in, set macro targets, manually log foods and workouts, review daily/weekly progress, manage coach invites/links, and exchange feedback. All data reads and writes go through gym-tracker-api; the webapp holds no credentials of its own.",
  "dependencies": [
    {
      "kind": "component",
      "name": "gym-tracker-api",
      "wiring": {
        "endpoint": {
          "component": "gym-macro-tracker231-gym-tracker-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "GYM_TRACKER_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "gym-macro-tracker-3164f253",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
