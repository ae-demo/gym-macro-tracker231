title Gym Macro Tracker

component gym-tracker-webapp as "Gym Macro Tracker" web-application
component gym-tracker-api as "Gym Macro Tracker API" service
component gym-tracker-db as "Gym Macro Tracker DB" database

east user-auth as "Thunder Auth" identity-server

